{
  "name": "@laststance/claude-plugin-dashboard",
  "version": "0.3.2",
  "description": "Interactive CLI dashboard to manage Claude Code plugins",
  "license": "MIT",
  "author": "Ryota Murakami <ryota.murakami@laststance.io> (https://github.com/ryota-murakami)",
  "repository": {
    "type": "git",
    "url": "https://github.com/laststance/claude-plugin-dashboard"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "claude",
    "claude-code",
    "plugin",
    "cli",
    "dashboard",
    "anthropic",
    "terminal",
    "tui"
  ],
  "bin": {
    "claude-plugin-dashboard": "./dist/cli.js"
  },
  "main": "./dist/app.js",
  "types": "./dist/app.d.ts",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@10.26.2",
  "lint-staged": {
    "*": "prettier --ignore-unknown --write"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "link": "pnpm build && pnpm link --global",
    "prepublishOnly": "pnpm build",
    "prepare": "husky",
    "prettier": "prettier --ignore-unknown --write .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "push-release-commit": "push-release-commit"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.11.2",
    "fullscreen-ink": "^0.1.0",
    "ink": "^5.1.0",
    "react": "^18.3.1",
    "react-redux": "^9.2.0",
    "ts-pattern": "^5.9.0"
  },
  "devDependencies": {
    "@laststance/npm-publish-tool": "^2.1.0",
    "@sindresorhus/tsconfig": "^6.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@vitest/coverage-v8": "^4.0.16",
    "husky": "^9.1.7",
    "ink-testing-library": "^4.0.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "release-it": "^19.2.4",
    "typescript": "^5.7.2",
    "vitest": "^4.0.16"
  }
}
